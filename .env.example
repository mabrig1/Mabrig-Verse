# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Smallest working production render path
# docker-compose.yml supplies these defaults automatically.
MONGODB_URI=mongodb://mongo:27017/mabrigverse
REDIS_URL=redis://redis:6379
STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=/data/media
GPU_WORKER_URL=http://worker:8080
GPU_WORKER_TOKEN=local-dev-worker

# Optional AI provider router — NOT required for the first FFmpeg proof render
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Optional Cloudflare R2 adapter — leave blank while STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mabrig-verse

# Phase 2 distribution OAuth / APIs — intentionally disabled until configured
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WEBSITE_PUBLISH_URL=
WEBSITE_PUBLISH_TOKEN=
